# --- Projet spécifiques ---
# Ignorer data brutes et dérivées, garder la structure
00_data/input/*
!00_data/input/.gitkeep
00_data/input/raw/*
!00_data/input/raw/.gitkeep
00_data/input/processed/*
!00_data/input/processed/.gitkeep

00_data/output/*
!00_data/output/.gitkeep
# (Décommente pour versionner un export final précis)
# !00_data/output/name_analysis_summary_2024.csv

# --- Ressources / images : tout ignorer
00_ressources/
00_images_and_header/

# RStudio export libs très lourds (widgets html) dans les notebooks
